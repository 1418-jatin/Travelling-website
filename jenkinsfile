pipeline {
    agent { label 'slave-node' }

    environment {
        DOCKER_REPO  = "19901418/my-jenkins-python-app-ci-cd"
        DOCKER_IMAGE = "19901418/my-jenkins-python-app-ci-cd:${BUILD_NUMBER}"
        MASTER_IP    = "18.188.124.101"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/1418-jatin/Travelling-website.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build -t ${DOCKER_IMAGE} .
                    docker tag ${DOCKER_IMAGE} ${DOCKER_REPO}:latest
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-cred',
                                                 usernameVariable: 'DOCKER_USER',
                                                 passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                        docker push ${DOCKER_IMAGE}
                        docker push ${DOCKER_REPO}:latest
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ubuntu-cred',
                                                  keyFileVariable: 'PEM_KEY')]) {
                    sh '''
                        SSH_OPTS="-i $PEM_KEY -o StrictHostKeyChecking=no"

                        # put the real image name into the manifest
                        sed -i "s|IMAGE_TAG|${DOCKER_IMAGE}|g" deployment.yaml

                        # copy manifests from this checkout to the master
                        ssh $SSH_OPTS ubuntu@${MASTER_IP} "mkdir -p ~/PRT"
                        scp $SSH_OPTS deployment.yaml service.yml ubuntu@${MASTER_IP}:~/PRT/

                        # apply and wait
                        ssh $SSH_OPTS ubuntu@${MASTER_IP} "
                            kubectl apply -f ~/PRT/deployment.yaml &&
                            kubectl apply -f ~/PRT/service.yml &&
                            kubectl rollout status deployment/travel-website-deployment --timeout=120s
                        "
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }
    }
}
